{
  "name": "@patimweb/pi-azure-devops",
  "version": "2.0.1",
  "description": "Azure DevOps integration for pi coding agent — work items, boards, repos, pull requests, pipelines, and test plans",
  "keywords": [
    "pi-package",
    "azure-devops",
    "ado",
    "pi-extension"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-azure-devops.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-azure-devops/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test 'test/**/*.test.ts'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'test/**/*.test.ts'"
  },
  "dependencies": {
    "azure-devops-node-api": "^15.1.0",
    "typebox": "^1.2.8",
    "@earendil-works/pi-tui": "^0.80.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.70.0",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-tui": "^0.80.3",
    "@semantic-release/git": "^10.0.0",
    "semantic-release": "^25.0.0"
  },
  "overrides": {
    "undici": "7.28.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-azure-devops/main/screenshot.png"
  }
}
