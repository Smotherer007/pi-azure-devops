{
  "name": "@patimweb/pi-azure-devops",
  "version": "1.3.4",
  "description": "Azure DevOps integration for pi coding agent — work items, boards, repos, pull requests, pipelines, and test plans",
  "keywords": [
    "pi-package",
    "azure-devops",
    "ado",
    "pi-extension"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-azure-devops.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-azure-devops/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "azure-devops-node-api": "^15.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.70.0",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "semantic-release": "^25.0.0",
    "@semantic-release/git": "^10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "image": "https://raw.githubusercontent.com/Smotherer007/pi-azure-devops/main/screenshot.png"
  }
}
